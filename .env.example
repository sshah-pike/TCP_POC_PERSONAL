# AI provider (observation source only). Foundry is the only model provider used by this POC.
TCP_AI_PROVIDER=foundry
# Foundry connection (common to every deployment of the resource) and model profile (config/foundry_profiles.json)
TCP_FOUNDRY_API_KEY=
TCP_FOUNDRY_ENDPOINT=
# TCP_FOUNDRY_PROFILE=gpt-5.6-sol
# TCP_AI_EFFORT=high
# Not used by this POC (direct Anthropic provider, see REDUNDANT_CODE.md):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# TCP_AI_FALLBACKS=default   # set to off to disable server-side refusal fallback

# Map / aerial provider. Azure Maps is the only imagery provider used by this POC.
TCP_MAP_PROVIDER=azure_maps          # usgs_naip / esri_demo remain in code but are not used (REDUNDANT_CODE.md)
AZURE_MAPS_KEY=

# Diagnostics
# TCP_DEBUG_SENT=1   # write every model request (images, prompts, schema) to ./debug_sent/ - off by default

# Optional
# TCP_RULE_PACK=path\to\APPROVED_TWO_LANE_POC_RULE_PACK.json
# TCP_ODA_FILE_CONVERTER=C:\Program Files\ODA\ODAFileConverter 26.x\ODAFileConverter.exe
# TCP_TELEMETRY_CONSOLE=1

# SME Review Assistant (off by default). When false the pipeline and UI run exactly as before.
TCP_SME_ASSISTANT_ENABLED=false
# TCP_ASSISTANT_DATA_DIR=assistant_data

  "05_sign_selection_rules": [
    {
      "id": "TA1-SIGN-01",
      "strength": "OPTION",
      "when": {
        "work.location": "ADJACENT_TO_SHOULDER"
      },
      "action": {
        "replace": "W20-1",
        "with": "SHOULDER_WORK"
      }
    },
    {
      "id": "TA1-SIGN-02",
      "strength": "OPTION",
      "when_any": [
        {
          "work.behind_barrier": true
        },
        {
          "work.distance_behind_curb_in": ">24"
        },
        {
          "work.distance_from_edge_of_roadway_ft": ">=15"
        }
      ],
      "action": {
        "W20-1": "MAY_BE_OMITTED"
      }
    },
    {
      "id": "TA1-SIGN-03",
      "strength": "OPTION",
      "when": {
        "operation_type": [
          "SHORT_TERM",
          "SHORT_DURATION",
          "MOBILE"
        ],
        "vehicle_high_intensity_warning_lights": true
      },
      "action": {
        "all_signs_and_channelizing_devices": "MAY_BE_ELIMINATED"
      }
    },
    {
      "id": "TA1-SIGN-04",
      "strength": "STANDARD",
      "when": {
        "vehicle_hazard_warning_signals": true
      },
      "action": {
        "hazard_signals_cannot_replace_high_intensity_warning_lights": true
      }
    }
  ],

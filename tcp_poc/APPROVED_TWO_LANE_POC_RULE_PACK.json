    "definitions": {
      "A": "restriction/transition to nearest sign",
      "B": "nearest sign to second sign",
      "C": "second sign to furthest upstream sign"
    },
    "application": "Distances are approximate guidance and are adjusted using engineering judgment for field conditions. TA-1 uses the applicable A dimension for W20-1."
  },
  "07_taper_formulas": {
    "table": "6B-3 and 6B-4",
    "variables": {
      "L": "taper length, ft",
      "W": "offset width, ft",
      "S": "speed, mph"
    },
    "base_L": [
      {
        "when": "S <= 40",
        "formula": "L = W * S^2 / 60"
      },
      {
        "when": "S >= 45",
        "formula": "L = W * S"
      }
    ],
    "taper_types": {
      "MERGING": "at least L",
      "SHIFTING": "at least 0.5 * L",
      "SHOULDER": "at least 0.33 * L",
      "ONE_LANE_TWO_WAY": {
        "min_ft": 50,
        "max_ft": 100
      }
    },
    "active_for_selected_TA": false,
    "selected_TA_value_ft": 0,
    "reason": "TA-1 does not shift or close a traveled lane"
  },

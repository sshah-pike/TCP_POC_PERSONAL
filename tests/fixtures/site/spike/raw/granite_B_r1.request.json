        "required": [
          "facts",
          "marks"
        ],
        "properties": {
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "value",
                "unit",
                "status",
                "confidence",
                "evidence"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "enum": [
                    "work_location",
                    "work_side",
                    "lanes_per_direction",
                    "oneway",
                    "shoulder_present",
                    "divided_highway",
                    "median_work",
                    "bicycle_lane_present",
                    "sidewalk_present",
                    "sidewalk_side",
                    "parking_present",
                    "bus_stop_present",
                    "driveway_present",
                    "crosswalk_present",
                    "intersection_in_view",
                    "grade_crossing_present",
                    "obstructions",
                    "approaching_lanes_one"
                  ]
                },
                "value": {
                  "type": "string"
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "bool",
                    "count",
                    "enum",
                    "text",
                    "none"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "RESOLVED",
                    "UNKNOWN",
                    "CONFLICT"
                  ]
                },
                "confidence": {
                  "type": "number"
                },
                "evidence": {
                  "type": "string"
                }
              }
            }
          },
          "marks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "feature",
                "points",
                "status",
                "evidence"
              ],
              "properties": {
                "feature": {
                  "type": "string",
                  "enum": [
                    "road_edge_left",
                    "road_edge_right",
                    "lane_line",
                    "shoulder_edge",
                    "work_point",
                    "curb"
                  ]
                },
                "points": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "RESOLVED",
                    "UNKNOWN"
                  ]
                },
                "evidence": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "image",
          "file": "inputs\\granite.jpg",
          "sha256": "5560a76ca2ceb41fbe8c99df91a6f643aaf161137efb20fd55362e00ae947fb3",
          "bytes": 447191
        },
        {
          "type": "text",
          "text": "The image is 1280x1280 px, north-up, about 0.448 m per pixel. The work location is at the exact image centre (pixel 640,640). Sides are compass directions (N, S, E, W).\nReport for the road nearest the work location, at the work location:\n- work_location: ROADWAY, SHOULDER, BEYOND_SHOULDER, SIDEWALK, or UNKNOWN.\n- work_side: N, S, E or W of the road centreline.\n- lanes_per_direction: number of through lanes in one direction (a count).\n- oneway, shoulder_present, divided_highway, median_work, bicycle_lane_present, sidewalk_present, parking_present, bus_stop_present, driveway_present, crosswalk_present, intersection_in_view, grade_crossing_present, approaching_lanes_one: true, false or UNKNOWN.\n- sidewalk_side: N, S, E, W, BOTH, NONE or UNKNOWN.\n- obstructions: a short list of visible obstructions, or NONE.\nImage positions, as 'x1,y1;x2,y2;...' in image pixels: left road edge, right road edge (left/right facing north), each lane line, shoulder edge, work point, curb.\nReturn the JSON object only: one entry in facts for each field listed above, and one entry in marks per visible feature (one entry per lane line)."
        }
      ]
    }
  ]
}
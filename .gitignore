# Secrets / local config (keep .env.example)
.env
.env.*
!.env.example

# Backups and archives
backup/*
!backup/orphans/
*.zip
*.bak
*- Copy*

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Node / frontend build
node_modules/
dist/

# Run outputs, labels, assistant data, debug dumps. var/runs/ holds the tracked POC-era runs;
# new runs written there are ignored.
var/*

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Claude Code local settings
.claude/settings.local.json

# SME Review Assistant: local identities (assistant data lives under var/)
config/assistant/users.local.json

# S2 state/artifact store temp and lock files (OneDrive may sync them; never commit)
*.lock.stale-*
.tmp-*

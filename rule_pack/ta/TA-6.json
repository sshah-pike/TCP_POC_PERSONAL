      {"id": "R-TA6-N11", "layer": "FEDERAL", "ta_id": "TA-6", "jurisdiction": null, "topic": "vehicle_lights", "strength": "OPTION",
       "text": "Vehicle hazard warning signals may supplement high-intensity lights.",
       "condition": null, "action": null, "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6P6-N11"]},
      {"id": "R-TA6-N12", "layer": "FEDERAL", "ta_id": "TA-6", "jurisdiction": null, "topic": "vehicle_mounted_signs", "strength": "STANDARD",
       "text": "Vehicle-mounted signs not obscured; legends covered or turned when work is not in progress.",
       "condition": null, "action": null, "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6P6-N12"]},
      {"id": "R-TA6-N13", "layer": "FEDERAL", "ta_id": "TA-6", "jurisdiction": null, "topic": "vehicle_lights", "strength": "STANDARD",

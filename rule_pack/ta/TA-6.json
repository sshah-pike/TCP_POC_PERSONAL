       "text": "All lanes at least 10 ft wide, measured to the near face of the channelizing devices.",
       "condition": {"field": "remaining_lane_width_ft", "op": "LT", "value": 10}, "action": "LANE_CLOSURE_NEEDED",
       "value": 10, "value_max": null, "unit": "ft", "qualifier": "AT_LEAST",

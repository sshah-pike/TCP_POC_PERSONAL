       "quote": "Notes for Figure 6P-6—Typical Application 6 Shoulder Work with Minor Encroachment"},
      {"id": "SR-6P6-FIG-TITLE", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": null, "table": null, "figure": "6P-6", "note": null,
       "page_printed": "871", "page_pdf": 107, "strength": "SUPPORT", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Figure 6P-6. Shoulder Work with Minor Encroachment (TA-6)"},
      {"id": "SR-6N07-P05", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6N.07", "paragraph": "05", "table": null, "figure": "6P-6", "note": null,
       "page_printed": "846", "page_pdf": 82, "strength": "SUPPORT", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Figure 6P-6 illustrates a method for handling vehicular traffic where the stationary or short-duration work space encroaches slightly into the traveled way."},
      {"id": "SR-6P6-N1", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": null, "table": null, "figure": "6P-6", "note": "1",
       "page_printed": "870", "page_pdf": 106, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "All lanes should be a minimum of 10 feet in width as measured to the near face of the channelizing devices."},
      {"id": "SR-6P6-N2", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": null, "table": null, "figure": "6P-6", "note": "2",
       "page_printed": "870", "page_pdf": 106, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "The treatment shown should be used on a minor road having low speeds. For higher-speed traffic conditions, a lane closure should be used."},
      {"id": "SR-6P6-N3", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": null, "table": null, "figure": "6P-6", "note": "3",
       "page_printed": "870", "page_pdf": 106, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Additional positive protection devices may be used per Section 6M.02."},
      {"id": "SR-6P6-N4", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": null, "table": null, "figure": "6P-6", "note": "4",
       "page_printed": "870", "page_pdf": 106, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "For short-term use on low-volume, low-speed roadways with vehicular traffic that does not include longer and wider heavy commercial vehicles, a minimum lane width of 9 feet may be used."},
      {"id": "SR-6P6-N5", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": null, "table": null, "figure": "6P-6", "note": "5",
       "page_printed": "870", "page_pdf": 106, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Where the opposite shoulder is suitable for carrying vehicular traffic and of adequate width, lanes may be shifted by use of closely-spaced channelizing devices, provided that the minimum lane width of 10 feet is maintained."},
      {"id": "SR-6P6-N6", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": null, "table": null, "figure": "6P-6", "note": "6",
       "page_printed": "870", "page_pdf": 106, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Additional advance warning may be appropriate, such as a ROAD NARROWS sign."},
      {"id": "SR-6P6-N7", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": null, "table": null, "figure": "6P-6", "note": "7",
       "page_printed": "870", "page_pdf": 106, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Temporary traffic barriers may be used along the work space."},
      {"id": "SR-6P6-N8", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": null, "table": null, "figure": "6P-6", "note": "8",
       "page_printed": "870", "page_pdf": 106, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "The shadow vehicle may be omitted if a taper and channelizing devices are used."},
      {"id": "SR-6P6-N9", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": null, "table": null, "figure": "6P-6", "note": "9",
       "page_printed": "870", "page_pdf": 106, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "A truck-mounted attenuator may be used on the shadow vehicle."},
      {"id": "SR-6P6-N10", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": null, "table": null, "figure": "6P-6", "note": "10",
       "page_printed": "870", "page_pdf": 106, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "For short-duration work, the taper and channelizing devices may be omitted if a shadow vehicle with activated high-intensity rotating, flashing, oscillating, or strobe lights is used."},
      {"id": "SR-6P6-N11", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": null, "table": null, "figure": "6P-6", "note": "11",
       "page_printed": "870", "page_pdf": 106, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Vehicle hazard warning signals may be used to supplement high-intensity rotating, flashing, oscillating, or strobe lights."},
      {"id": "SR-6P6-N12", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": null, "table": null, "figure": "6P-6", "note": "12",
       "page_printed": "870", "page_pdf": 106, "strength": "STANDARD", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Vehicle-mounted signs shall be mounted in a manner such that they are not obscured by equipment or supplies. Sign legends on vehicle-mounted signs shall be covered or turned from view when work is not in progress."},
      {"id": "SR-6P6-N13", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": null, "table": null, "figure": "6P-6", "note": "13",
       "page_printed": "870", "page_pdf": 106, "strength": "STANDARD", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Shadow and work vehicles shall display high-intensity rotating, flashing, oscillating, or strobe lights."},
      {"id": "SR-6P6-N14", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": null, "table": null, "figure": "6P-6", "note": "14",
       "page_printed": "870", "page_pdf": 106, "strength": "STANDARD", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Vehicle hazard warning signals shall not be used instead of the vehicle’s high-intensity rotating, flashing, oscillating, or strobe lights."},
      {"id": "SR-6P6-FIG-SIGNS", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": null, "table": null, "figure": "6P-6", "note": null,
       "page_printed": "871", "page_pdf": 107, "strength": "GUIDANCE", "evidence": "FIGURE_TRANSCRIPTION", "quote": null,
       "transcription": "Figure 6P-6 shows both directions. Each approach has a W20-1 ROAD WORK AHEAD sign on its right-hand roadside at dimension A upstream (southbound: A from the start of the work area; northbound: A from the start of the shoulder taper). Each direction has a G20-2 END ROAD WORK sign labelled '(optional)' past the work area. The work space is on the right shoulder with a 'Work vehicle' and a 'Truck-mounted attenuator (optional)' upstream of it.",
       "figure_render": {"uri": "tests/fixtures/rule_pack_sources/figures/figure_6P-6_p871.png", "sha256": "ca5b205c0c1e5032ccdc29a9ce9cdd9b7ae302149f715179c014acf5fa84d3a5", "size": 113857, "media_type": "image/png"}},
      {"id": "SR-6P6-FIG-TAPER", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": null, "table": null, "figure": "6P-6", "note": null,
       "page_printed": "871", "page_pdf": 107, "strength": "GUIDANCE", "evidence": "FIGURE_TRANSCRIPTION", "quote": null,
       "transcription": "Figure 6P-6, northbound: a shoulder taper of channelizing devices dimensioned '1/3 L', then a dimension labelled 'Buffer space (optional)', then the work vehicle and work space. A dimension labelled '10 ft MIN.' runs from the near face of the channelizing devices across the open northbound lane.",
       "figure_render": {"uri": "tests/fixtures/rule_pack_sources/figures/figure_6P-6_p871.png", "sha256": "ca5b205c0c1e5032ccdc29a9ce9cdd9b7ae302149f715179c014acf5fa84d3a5", "size": 113857, "media_type": "image/png"}},
      {"id": "SR-6P6-FIG-ANCHOR", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": null, "table": null, "figure": "6P-6", "note": null, "page_printed": "871", "page_pdf": 107, "strength": "GUIDANCE", "evidence": "FIGURE_TRANSCRIPTION", "quote": null, "transcription": "Figure 6P-6, northbound (the approach on the work side): A runs from the W20-1 sign support to the upstream end of the shoulder taper; downstream of it come the shoulder taper ('1/3 L'), the optional buffer space and the work vehicle. Southbound (the opposite approach): A runs from the W20-1 sign support to a line level with the near end of the work space; no taper is drawn on that side. Only A is drawn on each approach.", "figure_render": {"uri": "tests/fixtures/rule_pack_sources/figures/figure_6P-6_p871.png", "sha256": "ca5b205c0c1e5032ccdc29a9ce9cdd9b7ae302149f715179c014acf5fa84d3a5", "size": 113857, "media_type": "image/png"}}
    ],
    "ta": [
      {"id": "TA-6", "title": "Shoulder Work with Minor Encroachment", "figure": "6P-6", "source_ref_ids": ["SR-6P6-TITLE", "SR-6P6-FIG-TITLE"]}
    ],
    "eligibility_condition": [
      {"id": "E-TA6-WORK-LOCATION", "ta_id": "TA-6", "description": "The work is on the shoulder, encroaching slightly into the traveled way (figure title; Sect. 6N.07 para 05; D-60 tree).",

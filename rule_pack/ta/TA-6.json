       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6P6-N2"]},
      {"id": "E-TA6-MINOR-ROAD", "ta_id": "TA-6", "description": "The road is a 'minor road' (note 2). The MUTCD does not define it and road_type has no minor class.",
       "expr": null, "status": "SOURCE_REVIEW_REQUIRED", "interpretation": null,
       "sme_question": "TA-6 note 2 limits TA-6 to 'a minor road having low speeds'. The MUTCD does not define 'minor road' and the road types are urban low/high speed, rural and expressway/freeway. How should 'minor road' be decided?",
       "source_ref_ids": ["SR-6P6-N2"]},
      {"id": "E-TA6-REMAINING-WIDTH", "ta_id": "TA-6", "description": "Remaining lane width at least 10 ft to the near face of the devices (note 1), or at least 9 ft under the note 4 option.",
       "expr": {"any": [{"field": "remaining_lane_width_ft", "op": "GE", "value": 10},
                        {"all": [{"field": "remaining_lane_width_ft", "op": "GE", "value": 9}, {"field": "duration", "op": "EQ", "value": "SHORT_TERM"},
                                 {"field": "traffic_volume", "op": "EQ", "value": "LOW"}, {"field": "low_speed_road", "op": "EQ", "value": true},
                                 {"field": "heavy_vehicles", "op": "EQ", "value": false}]}]},
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6P6-N1", "SR-6P6-N4"]}
    ],
    "rule": [

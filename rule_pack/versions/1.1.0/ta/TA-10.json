    "rule": [
      {"id": "R-TA10-METHOD-FLAGGER", "layer": "FEDERAL", "ta_id": "TA-10", "jurisdiction": null, "topic": "traffic_control_method", "strength": "OPTION",
       "text": "TA-10 uses flaggers; code sets traffic_control_method to FLAGGER when TA-10 is chosen (D-68). A police detail is a post-draft SME review action, not a pack rule.",
       "condition": null, "action": "SET_TRAFFIC_CONTROL_METHOD_FLAGGER", "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6N09-P07", "SR-6P10-TITLE"]},
      {"id": "R-TA10-N1", "layer": "FEDERAL", "ta_id": "TA-10", "jurisdiction": null, "topic": "positive_protection", "strength": "OPTION",
       "text": "Positive protection devices may be used (Sect. 6M.02).",
       "condition": null, "action": null, "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6P10-N1"]},
      {"id": "R-TA10-N2", "layer": "FEDERAL", "ta_id": "TA-10", "jurisdiction": null, "topic": "single_flagger", "strength": "OPTION",
       "text": "Low volume, short TTC zone, straight roadway, flagger visible from both directions: a single flagger may be used. 'Short' has no number (R-TA10-SHORT-ZONE), so single_flagger_eligible cannot be computed yet.",
       "condition": {"all": [{"field": "traffic_volume", "op": "EQ", "value": "LOW"}, {"field": "single_flagger_eligible", "op": "EQ", "value": true}]},
       "action": "SINGLE_FLAGGER_ALLOWED", "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6P10-N2"]},
      {"id": "R-TA10-SHORT-ZONE", "layer": "FEDERAL", "ta_id": "TA-10", "jurisdiction": null, "topic": "single_flagger", "strength": "OPTION",
       "text": "Maximum length of a 'short TTC zone' for the single-flagger option (note 2). The MUTCD gives no number.",
       "condition": null, "action": null, "value": null, "value_max": null, "unit": "ft", "qualifier": null,
       "status": "SOURCE_REVIEW_REQUIRED", "interpretation": null,
       "sme_question": "TA-10 note 2 allows a single flagger for 'short TTC zones' but gives no length. What is the longest zone (ft) that counts as short, or should the single-flagger option always be an SME choice?",
       "source_ref_ids": ["SR-6P10-N2"]},
      {"id": "R-TA10-N3", "layer": "FEDERAL", "ta_id": "TA-10", "jurisdiction": null, "topic": "short_or_mobile_work", "strength": "OPTION",
       "text": "Short-duration operations: ROAD WORK AHEAD and END ROAD WORK may be omitted.",
       "condition": {"field": "duration", "op": "EQ", "value": "SHORT_DURATION"}, "action": "W20-1_AND_G20-2_MAY_BE_OMITTED",
       "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6P10-N3"]},
      {"id": "R-TA10-N4", "layer": "FEDERAL", "ta_id": "TA-10", "jurisdiction": null, "topic": "advance_sign_choice", "strength": "OPTION",
       "text": "Flashing warning lights and/or flags may be used on the advance signs; a BE PREPARED TO STOP sign may be added.",
       "condition": null, "action": "BE_PREPARED_TO_STOP_MAY_BE_ADDED", "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6P10-N4"]},
      {"id": "R-TA10-N5", "layer": "FEDERAL", "ta_id": "TA-10", "jurisdiction": null, "topic": "afad", "strength": "OPTION",
       "text": "AFADs may be used where only one lane of approaching traffic is to be controlled. AFADs are future scope (D-68).",
       "condition": {"field": "approaching_lanes_one", "op": "EQ", "value": true}, "action": "AFAD_ALLOWED",
       "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6P10-N5"]},
      {"id": "R-TA10-N6", "layer": "FEDERAL", "ta_id": "TA-10", "jurisdiction": null, "topic": "longitudinal_buffer", "strength": "GUIDANCE",
       "text": "Extend the buffer so the two-way traffic taper is before a horizontal or crest vertical curve. The extension is geometric (computed by code), not a number.",
       "condition": {"field": "curve_or_crest_near_zone", "op": "EQ", "value": true}, "action": "EXTEND_BUFFER_BEFORE_CURVE",
       "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6P10-N6"]},
      {"id": "R-TA10-N7", "layer": "FEDERAL", "ta_id": "TA-10", "jurisdiction": null, "topic": "night_work", "strength": "STANDARD",
       "text": "At night, flagger stations shall be illuminated, except in emergencies.",
       "condition": {"field": "night_work", "op": "EQ", "value": true}, "action": "ILLUMINATE_FLAGGER_STATIONS",
       "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6P10-N7"]},
      {"id": "R-TA10-N8", "layer": "FEDERAL", "ta_id": "TA-10", "jurisdiction": null, "topic": "advance_sign_order", "strength": "GUIDANCE",
       "text": "A BE PREPARED TO STOP sign, when used, goes between the Flagger sign and the ONE LANE ROAD sign.",
       "condition": null, "action": null, "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6P10-N8"]},
      {"id": "R-TA10-N9", "layer": "FEDERAL", "ta_id": "TA-10", "jurisdiction": null, "topic": "grade_crossing", "strength": "GUIDANCE",
       "text": "Grade crossing within or upstream of the transition area and queues may reach it: extend the TTC zone so the transition precedes the crossing.",
       "condition": {"field": "grade_crossing_present", "op": "EQ", "value": true}, "action": "EXTEND_ZONE_BEFORE_GRADE_CROSSING",
       "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6P10-N9"]},
      {"id": "R-TA10-N10", "layer": "FEDERAL", "ta_id": "TA-10", "jurisdiction": null, "topic": "grade_crossing", "strength": "GUIDANCE",
       "text": "Grade crossing with active warning devices within the activity area: keep flaggers informed of their activation status.",
       "condition": {"field": "grade_crossing_present", "op": "EQ", "value": true}, "action": null,
       "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6P10-N10"]},
      {"id": "R-TA10-N11", "layer": "FEDERAL", "ta_id": "TA-10", "jurisdiction": null, "topic": "grade_crossing", "strength": "GUIDANCE",
       "text": "Grade crossing within the activity area: drivers left of the normal center line get comparable warning devices.",
       "condition": {"field": "grade_crossing_present", "op": "EQ", "value": true}, "action": null,
       "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6P10-N11"]},
      {"id": "R-TA10-N12", "layer": "FEDERAL", "ta_id": "TA-10", "jurisdiction": null, "topic": "grade_crossing", "strength": "GUIDANCE",
       "text": "Coordinate early with the railroad company or transit agency.",
       "condition": {"field": "grade_crossing_present", "op": "EQ", "value": true}, "action": null,
       "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6P10-N12"]},
      {"id": "R-TA10-N13", "layer": "FEDERAL", "ta_id": "TA-10", "jurisdiction": null, "topic": "grade_crossing", "strength": "OPTION",
       "text": "A flagger or uniformed law enforcement officer may be used at the grade crossing so vehicles are not stopped within 15 ft of it.",
       "condition": {"field": "grade_crossing_present", "op": "EQ", "value": true}, "action": null,
       "value": 15, "value_max": null, "unit": "ft", "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6P10-N13"]},
      {"id": "R-TA10-FIG-TAPER", "layer": "FEDERAL", "ta_id": "TA-10", "jurisdiction": null, "topic": "one_lane_two_way_taper", "strength": "GUIDANCE",
       "text": "The figure dimensions each one-lane, two-way taper '50 to 100 ft'. Cited only: Table 6B-3 (T-6B3-ONE_LANE_TWO_WAY) applies.",
       "condition": null, "action": null, "value": 50, "value_max": 100, "unit": "ft", "qualifier": null,

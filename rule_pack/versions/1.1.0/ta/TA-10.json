      {"id": "R-TA10-ANCHOR-A", "layer": "FEDERAL", "ta_id": "TA-10", "jurisdiction": null, "topic": "advance_sign_anchor", "strength": "GUIDANCE", "text": "Each approach: A is measured upstream from the flagger station, which stands at the upstream end of the one-lane, two-way taper; B and C follow consecutively.", "condition": null, "action": "A_ENDS_AT_FLAGGER_STATION", "value": null, "value_max": null, "unit": null, "qualifier": null, "status": "SOURCED", "sme_question": null, "interpretation": "INTERPRETATION (owner-accepted reading of the figure render, S4b stage C): A ends at the flagger station (the line level with the flagger), not at the work space; the taper lies downstream of that line.", "source_ref_ids": ["SR-6P10-FIG-ANCHOR", "SR-6B1-NOTE-ABC"]}
    ],
    "ta_device_use": [
      {"id": "TDU-TA10-W20-7", "ta_id": "TA-10", "device_id": "DV-W20-7", "approach": "each approach", "sequence": 1, "spacing_dimension": "A", "required": true, "source_ref_ids": ["SR-6P10-FIG-SIGNS"]},

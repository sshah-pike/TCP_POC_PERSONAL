  "tables": {
    "source_document": [
      {"id": "SD-MUTCD11-CH6-2023-12", "title": "Manual on Uniform Traffic Control Devices, Part 6, Chapter 6 (Temporary Traffic Control)",
       "publisher": "FHWA", "edition": "11th Edition", "revision": "December 2023", "authority_level": "FEDERAL",
       "artifact": {"uri": "docs/sources/CHAPTER 6 - DEC 2023 MUTCD REVISION.pdf",
                    "sha256": "16e03bf4c1a731c5e13a8c8c60a49231a12918f151655564859e341755c0dbf0", "size": 5029342,
                    "media_type": "application/pdf"}}
    ],
    "source_ref": [
      {"id": "SR-6B04-P03", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.04", "paragraph": "03", "table": null, "figure": null, "note": null,
       "page_printed": "771", "page_pdf": 7, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Typical distances for placement of advance warning signs on freeways and expressways should be longer because drivers are conditioned to uninterrupted flow. Therefore, the advance warning sign placement should extend on these facilities as far as ½ mile or more."},
      {"id": "SR-6B04-P04", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.04", "paragraph": "04", "table": null, "figure": null, "note": null,
       "page_printed": "771", "page_pdf": 7, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "On urban streets, the effective placement of the nearest warning sign to the TTC zone, in feet, should range from 4 to 8 times the speed limit in mph, with the high end of the range being used when speeds are relatively high. When two or more advance warning signs are used on higher-speed streets, such as major arterials, the advance warning area should extend a greater distance (see Table 6B-1)."},
      {"id": "SR-6B04-P05", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.04", "paragraph": "05", "table": null, "figure": null, "note": null,
       "page_printed": "771", "page_pdf": 7, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "When a single advance warning sign is used (in cases such as low-speed residential streets), the advance warning area may be as short as 100 feet."},
      {"id": "SR-6B04-P06", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.04", "paragraph": "06", "table": null, "figure": null, "note": null,
       "page_printed": "771", "page_pdf": 7, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Since rural highways are normally characterized by higher speeds, the effective placement of the first warning sign in feet should be substantially longer—from 8 to 12 times the speed limit in mph. Since two or more advance warning signs are normally used for these conditions, the advance warning area should extend 1,500 feet or more for open highway conditions (see Table 6B-1)."},
      {"id": "SR-6B04-P07", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.04", "paragraph": "07", "table": "6B-1", "figure": null, "note": null,
       "page_printed": "771", "page_pdf": 7, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "The distances contained in Table 6B-1 are approximate, are intended for guidance purposes only, and should be applied with engineering judgment. These distances should be adjusted for field conditions, if necessary, by increasing or decreasing the recommended distances."},

      {"id": "SR-6B1-TITLE", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.04", "paragraph": null, "table": "6B-1", "figure": null, "note": null,
       "page_printed": "773", "page_pdf": 9, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Table 6B-1. Recommended Advance Warning Sign Minimum Spacing"},
      {"id": "SR-6B1-NOTE-SPEED", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.04", "paragraph": null, "table": "6B-1", "figure": null, "note": "*",
       "page_printed": "773", "page_pdf": 9, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "* Speed category to be determined by the highway agency or owner of site roadways open to public travel."},
      {"id": "SR-6B1-NOTE-ABC", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.04", "paragraph": null, "table": "6B-1", "figure": null, "note": "**",
       "page_printed": "773", "page_pdf": 9, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "The A dimension is the distance from the transition or point of restriction to the first sign. The B dimension is the distance between the first and second signs. The C dimension is the distance between the second and third signs."},
      {"id": "SR-6B1-ULS", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.04", "paragraph": null, "table": "6B-1", "figure": null, "note": null,
       "page_printed": "773", "page_pdf": 9, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Urban (low speed)* 100 feet 100 feet 100 feet"},
      {"id": "SR-6B1-UHS", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.04", "paragraph": null, "table": "6B-1", "figure": null, "note": null,
       "page_printed": "773", "page_pdf": 9, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Urban (high speed)* 350 feet 350 feet 350 feet"},
      {"id": "SR-6B1-RUR", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.04", "paragraph": null, "table": "6B-1", "figure": null, "note": null,
       "page_printed": "773", "page_pdf": 9, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Rural 500 feet 500 feet 500 feet"},
      {"id": "SR-6B1-EXP", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.04", "paragraph": null, "table": "6B-1", "figure": null, "note": null,
       "page_printed": "773", "page_pdf": 9, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Expressway / Freeway 1,000 feet 1,500 feet 2,640 feet"},
      {"id": "SR-6B06-P11", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.06", "paragraph": "11", "table": "6B-2", "figure": null, "note": null,
       "page_printed": "773", "page_pdf": 9, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "If a longitudinal buffer space is used, the values shown in Table 6B-2 may be used to determine the length of the longitudinal buffer space."},

      {"id": "SR-6B2-TITLE", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.06", "paragraph": null, "table": "6B-2", "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Table 6B-2. Stopping Sight Distance as a Function of Speed"},
      {"id": "SR-6B2-NOTE", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.06", "paragraph": null, "table": "6B-2", "figure": null, "note": "*",
       "page_printed": "775", "page_pdf": 11, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "* Posted speed, off-peak 85th-percentile speed prior to work starting, or the anticipated operating speed"},
      {"id": "SR-6B2-20", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.06", "paragraph": null, "table": "6B-2", "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null, "quote": "20 mph 115 feet"},
      {"id": "SR-6B2-25", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.06", "paragraph": null, "table": "6B-2", "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null, "quote": "25 mph 155 feet"},
      {"id": "SR-6B2-30", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.06", "paragraph": null, "table": "6B-2", "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null, "quote": "30 mph 200 feet"},
      {"id": "SR-6B2-35", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.06", "paragraph": null, "table": "6B-2", "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null, "quote": "35 mph 250 feet"},
      {"id": "SR-6B2-40", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.06", "paragraph": null, "table": "6B-2", "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null, "quote": "40 mph 305 feet"},
      {"id": "SR-6B2-45", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.06", "paragraph": null, "table": "6B-2", "figure": null, "note": null,

      {"id": "SR-6B2-70", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.06", "paragraph": null, "table": "6B-2", "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null, "quote": "70 mph 730 feet"},
      {"id": "SR-6B2-75", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.06", "paragraph": null, "table": "6B-2", "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null, "quote": "75 mph 820 feet"},

      {"id": "SR-6B08-P04", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.08", "paragraph": "04", "table": null, "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "The appropriate taper length (L) should be determined using the criteria shown in Tables 6B-3 and 6B-4."},
      {"id": "SR-6B3-MERGING", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.08", "paragraph": null, "table": "6B-3", "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Merging Taper at least L"},
      {"id": "SR-6B3-SHIFTING", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.08", "paragraph": null, "table": "6B-3", "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Shifting Taper at least 0.5 L"},
      {"id": "SR-6B3-SHOULDER", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.08", "paragraph": null, "table": "6B-3", "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Shoulder Taper at least 0.33 L"},
      {"id": "SR-6B3-ONE-LANE", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.08", "paragraph": null, "table": "6B-3", "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "One-Lane, Two-Way Traffic Taper 50 feet minimum, 100 feet maximum"},
      {"id": "SR-6B3-DOWNSTREAM", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.08", "paragraph": null, "table": "6B-3", "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Downstream Taper 50 feet minimum, 100 feet maximum"},
      {"id": "SR-6B3-TITLE", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.08", "paragraph": null, "table": "6B-3", "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Table 6B-3. Taper Length Criteria for Temporary Traffic Control Zones"},
      {"id": "SR-6B4-FORMULAS", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.08", "paragraph": null, "table": "6B-4", "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "40 mph or less L equals WS squared divided by 60 45 mph or more L = WS"},
      {"id": "SR-6B4-DEFS", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.08", "paragraph": null, "table": "6B-4", "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Where: L = taper length in feet W = width of offset in feet S = posted speed limit, or off-peak 85th-percentile speed prior to work starting, or the anticipated operating speed in mph"},

      {"id": "SR-6B08-P08", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.08", "paragraph": "08", "table": null, "figure": null, "note": null,
       "page_printed": "776", "page_pdf": 12, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "A shifting taper should have a length of approximately ½ L (see Tables 6B-3 and 6B-4)."},
      {"id": "SR-6B08-P10", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.08", "paragraph": "10", "table": null, "figure": null, "note": null,
       "page_printed": "776", "page_pdf": 12, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "If used, shoulder tapers should have a length of approximately ¹⁄3 L (see Tables 6B-3 and 6B-4)."},
      {"id": "SR-6B08-P12", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.08", "paragraph": "12", "table": null, "figure": null, "note": null,
       "page_printed": "776", "page_pdf": 12, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "If used, a downstream taper should have a minimum length of 50 feet and a maximum length of 100 feet with devices placed at a spacing of approximately 20 feet."},
      {"id": "SR-6B08-P14", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.08", "paragraph": "14", "table": null, "figure": null, "note": null,
       "page_printed": "776", "page_pdf": 12, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "A taper having a minimum length of 50 feet and a maximum length of 100 feet with channelizing devices at approximately 20-foot spacing should be used to guide traffic into the one-lane section, and a downstream taper should be used to guide traffic back into their original lane."},

      {"id": "SR-6K01-P04", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6K.01", "paragraph": "04", "table": null, "figure": null, "note": null,
       "page_printed": "815", "page_pdf": 51, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "The spacing between cones, tubular markers, vertical panels, drums, and barricades should not exceed a distance in feet equal to 1 times the speed limit in mph when used for taper channelization, and should not exceed a distance in feet equal to 2 times the speed limit in mph when used for tangent channelization."},
      {"id": "SR-6K01-P05", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6K.01", "paragraph": "05", "table": null, "figure": null, "note": null,
       "page_printed": "815", "page_pdf": 51, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "When channelizing devices have the potential of leading vehicular traffic out of the intended vehicular traffic space as shown in Figure 6P-39, the channelizing devices should be extended a distance in feet of 2 times the speed limit in mph beyond the downstream end of the transition area."},

      {"id": "SR-6N07-P02", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6N.07", "paragraph": "02", "table": null, "figure": null, "note": null,
       "page_printed": "846", "page_pdf": 82, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "When work takes up part of a lane, vehicular traffic volumes, vehicle mix (buses, trucks, cars, and bicycles), speed, and capacity should be analyzed to determine whether the affected lane should be closed. Unless the lane encroachment permits a remaining lane width of 10 feet, the lane should be closed."},
      {"id": "SR-6N07-P03", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6N.07", "paragraph": "03", "table": null, "figure": null, "note": null,
       "page_printed": "846", "page_pdf": 82, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Truck off-tracking should be considered when determining whether the minimum lane width of 10 feet is adequate."},
      {"id": "SR-6N07-P04", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6N.07", "paragraph": "04", "table": null, "figure": null, "note": null,
       "page_printed": "846", "page_pdf": 82, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "A lane width of 9 feet may be used for short-term stationary work on low-volume, low-speed roadways when vehicular traffic does not include longer and wider heavy commercial vehicles."},
      {"id": "SR-6N08-P02", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6N.08", "paragraph": "02", "table": null, "figure": null, "note": null,
       "page_printed": "846", "page_pdf": 82, "strength": "GUIDANCE", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "If work in the median of a divided highway is within 15 feet from the edge of the traveled way for either direction of travel, TTC should be used through the use of advance warning signs and channelizing devices."},

      {"id": "SR-6N11-P02", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6N.11", "paragraph": "02", "table": null, "figure": null, "note": null,
       "page_printed": "847", "page_pdf": 83, "strength": "SUPPORT", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Work on multi-lane (two or more lanes of moving motor vehicle traffic in one direction) highways is divided into right-lane closures, left-lane closures, interior-lane closures, multiple-lane closures, and closures on five-lane roadways."},
      {"id": "SR-6N11-P03", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6N.11", "paragraph": "03", "table": null, "figure": null, "note": null,
       "page_printed": "847", "page_pdf": 83, "strength": "STANDARD", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "When a lane is closed on a multi-lane road for other than a mobile operation, a transition area containing a merging taper shall be used."},
      {"id": "SR-6N11-P06", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6N.11", "paragraph": "06", "table": null, "figure": "6P-33", "note": null,
       "page_printed": "847", "page_pdf": 83, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "When the right-hand lane is closed, TTC similar to that shown in Figure 6P-33 may be used for undivided or divided four-lane roads."},

      {"id": "SR-6P01-P02", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": "02", "table": null, "figure": null, "note": null,
       "page_printed": "857", "page_pdf": 93, "strength": "SUPPORT", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "In general, the procedures illustrated represent minimum solutions for the situations depicted. Except for the notes (which are clearly classified using headings as being Standard, Guidance, Option, or Support), the information presented in the typical applications can generally be regarded as Guidance."},
      {"id": "SR-6P01-P03", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": "03", "table": null, "figure": null, "note": null,
       "page_printed": "857", "page_pdf": 93, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "TTC plans may deviate from the typical applications described in this Chapter to allow for conditions and requirements of a particular site or jurisdiction."},
      {"id": "SR-6P01-P04", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": "04", "table": null, "figure": null, "note": null,
       "page_printed": "857", "page_pdf": 93, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Other devices may be added to supplement the devices and device spacing may be adjusted to provide additional reaction time or delineation. Fewer devices may be used based on field conditions."},
      {"id": "SR-6P01-P07", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6P.01", "paragraph": "07", "table": null, "figure": null, "note": null,
       "page_printed": "857", "page_pdf": 93, "strength": "SUPPORT", "evidence": "QUOTE", "transcription": null, "figure_render": null,
       "quote": "Most of the typical applications show TTC devices for only one direction."}
    ]
  }
}

      {"id": "SR-6B2-50", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.06", "paragraph": null, "table": "6B-2", "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null, "quote": "50 mph 425 feet"},
      {"id": "SR-6B2-55", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.06", "paragraph": null, "table": "6B-2", "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null, "quote": "55 mph 495 feet"},
      {"id": "SR-6B2-60", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.06", "paragraph": null, "table": "6B-2", "figure": null, "note": null,
       "page_printed": "775", "page_pdf": 11, "strength": "OPTION", "evidence": "QUOTE", "transcription": null, "figure_render": null, "quote": "60 mph 570 feet"},
      {"id": "SR-6B2-65", "source_document_id": "SD-MUTCD11-CH6-2023-12", "section": "6B.06", "paragraph": null, "table": "6B-2", "figure": null, "note": null,

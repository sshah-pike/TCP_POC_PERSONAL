      {"id": "SZ-W20-5R", "table_def_id": "T-6H1", "key": {"sign": "W20-5R"}, "values": {"conventional_width": 36, "conventional_height": 36, "freeway_expressway_width": 48, "freeway_expressway_height": 48, "minimum_width": 30, "minimum_height": 30}, "status": "SOURCED", "sme_question": null, "interpretation": "INTERPRETATION: sign code W20-5R is read as the Lane Closed (W20-5) sign with the legend RIGHT LANE CLOSED: Table 6H-1 lists W20-5 without a side and Sect. 6H.07 para 02 gives the RIGHT (LEFT) legend. Owner-approved 2026-10-30 (S4b stage A, decision 1).", "source_ref_ids": ["SR-6H1-W20-5-5a", "SR-6H07-P02"]},

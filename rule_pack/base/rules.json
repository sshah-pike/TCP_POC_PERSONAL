  "tables": {
    "rule": [
      {"id": "R-6B04-P03-FREEWAY-HALF-MILE", "layer": "FEDERAL", "ta_id": null, "jurisdiction": null, "topic": "advance_sign_spacing", "strength": "GUIDANCE",
       "text": "Freeway and expressway advance warning placement should extend as far as 1/2 mile or more. Cited only (owner decision): Table 6B-1 is applied.",
       "condition": null, "action": null, "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6B04-P03"],
       "role": "CITED_ONLY", "overlaps": ["T-6B1-EXPRESSWAY_FREEWAY"]},
      {"id": "R-6B04-P04-URBAN-NEAREST-SIGN", "layer": "FEDERAL", "ta_id": null, "jurisdiction": null, "topic": "advance_sign_spacing", "strength": "GUIDANCE",
       "text": "Urban streets: nearest warning sign, in feet, 4 to 8 times the speed limit in mph. Cited only (owner decision): Table 6B-1 is applied.",
       "condition": null, "action": null, "value": 4, "value_max": 8, "unit": "ratio", "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6B04-P04"],
       "role": "CITED_ONLY", "overlaps": ["T-6B1-URBAN_LOW_SPEED", "T-6B1-URBAN_HIGH_SPEED"]},
      {"id": "R-6B04-P05-SINGLE-SIGN-100FT", "layer": "FEDERAL", "ta_id": null, "jurisdiction": null, "topic": "advance_sign_spacing", "strength": "OPTION",
       "text": "With a single advance warning sign (e.g. low-speed residential streets) the advance warning area may be as short as 100 ft. Cited only (owner decision): Table 6B-1 is applied.",
       "condition": null, "action": null, "value": 100, "value_max": null, "unit": "ft", "qualifier": "AT_LEAST",
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6B04-P05"],
       "role": "CITED_ONLY", "overlaps": ["T-6B1-URBAN_LOW_SPEED"]},
      {"id": "R-6B04-P06-RURAL-FIRST-SIGN", "layer": "FEDERAL", "ta_id": null, "jurisdiction": null, "topic": "advance_sign_spacing", "strength": "GUIDANCE",
       "text": "Rural highways: first warning sign, in feet, 8 to 12 times the speed limit in mph. Cited only (owner decision): Table 6B-1 is applied.",
       "condition": null, "action": null, "value": 8, "value_max": 12, "unit": "ratio", "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6B04-P06"],
       "role": "CITED_ONLY", "overlaps": ["T-6B1-RURAL"]},
      {"id": "R-6B04-P06-RURAL-AREA-1500FT", "layer": "FEDERAL", "ta_id": null, "jurisdiction": null, "topic": "advance_sign_spacing", "strength": "GUIDANCE",
       "text": "Rural open highway: the advance warning area should extend 1,500 ft or more. Cited only (owner decision): Table 6B-1 is applied.",
       "condition": null, "action": null, "value": 1500, "value_max": null, "unit": "ft", "qualifier": "AT_LEAST",
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6B04-P06"],
       "role": "CITED_ONLY", "overlaps": ["T-6B1-RURAL"]},
      {"id": "R-6B04-TABLE-6B1-GUIDANCE", "layer": "FEDERAL", "ta_id": null, "jurisdiction": null, "topic": "advance_sign_spacing", "strength": "GUIDANCE",
       "text": "Table 6B-1 distances are approximate guidance, applied with engineering judgment and adjusted for field conditions.",
       "condition": null, "action": null, "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6B04-P07"]},
      {"id": "R-6B06-BUFFER-OPTION", "layer": "FEDERAL", "ta_id": null, "jurisdiction": null, "topic": "longitudinal_buffer", "strength": "OPTION",
       "text": "If a longitudinal buffer space is used, Table 6B-2 values may be used for its length.",
       "condition": null, "action": "BUFFER_LENGTH_FROM_T-6B2", "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6B06-P11"]},
      {"id": "R-6B08-DOWNSTREAM-DEVICE-SPACING", "layer": "FEDERAL", "ta_id": null, "jurisdiction": null, "topic": "device_spacing_downstream_taper", "strength": "GUIDANCE",
       "text": "Devices in a downstream taper at a spacing of approximately 20 ft.",
       "condition": null, "action": null, "value": 20, "value_max": null, "unit": "ft", "qualifier": "APPROXIMATE",
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6B08-P12"]},
      {"id": "R-6B08-ONE-LANE-TWO-WAY-DEVICE-SPACING", "layer": "FEDERAL", "ta_id": null, "jurisdiction": null, "topic": "device_spacing_one_lane_two_way_taper", "strength": "GUIDANCE",
       "text": "Channelizing devices in a one-lane, two-way taper at approximately 20 ft spacing.",
       "condition": null, "action": null, "value": 20, "value_max": null, "unit": "ft", "qualifier": "APPROXIMATE",
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6B08-P14"]},

      {"id": "R-6N07-REMAINING-WIDTH", "layer": "FEDERAL", "ta_id": null, "jurisdiction": null, "topic": "remaining_lane_width", "strength": "GUIDANCE",
       "text": "Unless the remaining lane width is 10 ft, the lane should be closed.",
       "condition": {"field": "remaining_lane_width_ft", "op": "LT", "value": 10}, "action": "LANE_CLOSURE_NEEDED",
       "value": 10, "value_max": null, "unit": "ft", "qualifier": "AT_LEAST",
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6N07-P02"]},
      {"id": "R-6N07-TRUCK-OFFTRACKING", "layer": "FEDERAL", "ta_id": null, "jurisdiction": null, "topic": "remaining_lane_width", "strength": "GUIDANCE",
       "text": "Consider truck off-tracking when judging whether the 10 ft minimum lane width is adequate.",
       "condition": null, "action": null, "value": 10, "value_max": null, "unit": "ft", "qualifier": "AT_LEAST",
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6N07-P03"]},
      {"id": "R-6N07-NINE-FT-OPTION", "layer": "FEDERAL", "ta_id": null, "jurisdiction": null, "topic": "remaining_lane_width", "strength": "OPTION",
       "text": "A 9 ft lane may be used for short-term stationary work on low-volume, low-speed roadways without longer and wider heavy commercial vehicles. 'Low-speed' has no number in the source (R-LOW-SPEED-CUTOFF), so low_speed_road stays UNKNOWN and this option cannot apply until the SME sets it.",
       "condition": {"all": [{"field": "duration", "op": "EQ", "value": "SHORT_TERM"}, {"field": "traffic_volume", "op": "EQ", "value": "LOW"},
                             {"field": "low_speed_road", "op": "EQ", "value": true}, {"field": "heavy_vehicles", "op": "EQ", "value": false}]},
       "action": "NINE_FT_LANE_ALLOWED", "value": 9, "value_max": null, "unit": "ft", "qualifier": "AT_LEAST",
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6N07-P04"]},
      {"id": "R-LOW-SPEED-CUTOFF", "layer": "FEDERAL", "ta_id": null, "jurisdiction": null, "topic": "low_speed_road", "strength": "OPTION",
       "text": "Speed at or below which a road counts as 'low-speed' (Sect. 6N.07 para 04; TA-6 notes 2 and 4 cite it in the TA layer). The MUTCD gives no number.",
       "condition": null, "action": null, "value": null, "value_max": null, "unit": "mph", "qualifier": null,
       "status": "SOURCE_REVIEW_REQUIRED", "interpretation": null,
       "sme_question": "The MUTCD says 'low-speed roadways' (Sect. 6N.07 para 04) and 'a minor road having low speeds' (TA-6 note 2) without a number. What posted speed, in mph, is the upper limit for 'low speed'?",
       "source_ref_ids": ["SR-6N07-P04", "SR-6P6-N2", "SR-6P6-N4"]},
      {"id": "R-6N08-MEDIAN-15FT", "layer": "FEDERAL", "ta_id": null, "jurisdiction": null, "topic": "median_work", "strength": "GUIDANCE",
       "text": "Median work within 15 ft of the traveled way edge for either direction should get advance warning signs and channelizing devices.",
       "condition": {"all": [{"field": "median_work", "op": "EQ", "value": true}, {"field": "distance_from_edge_ft", "op": "LE", "value": 15}]},
       "action": "ADVANCE_WARNING_AND_CHANNELIZING_DEVICES", "value": 15, "value_max": null, "unit": "ft", "qualifier": "AT_MOST",
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6N08-P02"]},

      {"id": "R-6N11-MERGING-TAPER", "layer": "FEDERAL", "ta_id": null, "jurisdiction": null, "topic": "multi_lane_closure", "strength": "STANDARD",
       "text": "A lane closed on a multi-lane road (two or more lanes in one direction), other than for a mobile operation, needs a transition area with a merging taper.",
       "condition": {"all": [{"field": "lane_closure", "op": "EQ", "value": true}, {"field": "lanes_per_direction", "op": "GE", "value": 2},
                             {"field": "duration", "op": "NE", "value": "MOBILE"}]},
       "action": "MERGING_TAPER_REQUIRED", "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6N11-P03", "SR-6N11-P02"]},
      {"id": "R-6N11-TA33-UNDIVIDED-FOUR-LANE", "layer": "FEDERAL", "ta_id": null, "jurisdiction": null, "topic": "ta33_applicability", "strength": "OPTION",
       "text": "When the right-hand lane is closed, TTC similar to Figure 6P-33 may be used for undivided or divided four-lane roads.",
       "condition": null, "action": null, "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCE_REVIEW_REQUIRED",
       "interpretation": "PROPOSED, not owner-approved: 'undivided or divided four-lane roads' read as divided_highway = false with lanes_per_direction = 2 (two lanes each way) and closed_lane_side = RIGHT. Para 02 defines multi-lane as 'two or more lanes of moving motor vehicle traffic in one direction'.",
       "sme_question": "Sect. 6N.11 para 06 allows Figure 6P-33 on 'undivided or divided four-lane roads' when the right-hand lane is closed. Is an undivided road with two lanes each way and the right lane closed the right reading of 'four-lane'?",
       "source_ref_ids": ["SR-6N11-P06", "SR-6N11-P02"]},

      {"id": "R-6P01-FIGURES-ARE-GUIDANCE", "layer": "FEDERAL", "ta_id": null, "jurisdiction": null, "topic": "typical_application_strength", "strength": "SUPPORT",
       "text": "Typical applications are minimum solutions; apart from the classified notes, their content is generally Guidance.",
       "condition": null, "action": null, "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6P01-P02"]},
      {"id": "R-6P01-MAY-DEVIATE", "layer": "FEDERAL", "ta_id": null, "jurisdiction": null, "topic": "typical_application_deviation", "strength": "OPTION",
       "text": "TTC plans may deviate from the typical applications for site or jurisdiction conditions.",
       "condition": null, "action": null, "value": null, "value_max": null, "unit": null, "qualifier": null,
       "status": "SOURCED", "sme_question": null, "interpretation": null, "source_ref_ids": ["SR-6P01-P03"]},
      {"id": "R-6P01-DEVICES-ADJUSTABLE", "layer": "FEDERAL", "ta_id": null, "jurisdiction": null, "topic": "typical_application_deviation", "strength": "OPTION",
       "text": "Devices may be added, device spacing adjusted for reaction time or delineation, and fewer devices used based on field conditions.",
